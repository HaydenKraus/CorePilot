<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <sys:String x:Key="Theme.Name">Dark</sys:String>

    <Color x:Key="Color.Window">#FF0E1117</Color>
    <Color x:Key="Color.Surface">#FF161A23</Color>
    <Color x:Key="Color.SurfaceAlt">#FF1B2029</Color>
    <Color x:Key="Color.SurfaceHover">#FF232935</Color>
    <Color x:Key="Color.SurfacePressed">#FF2A3140</Color>
    <Color x:Key="Color.Border">#FF212630</Color>
    <Color x:Key="Color.BorderStrong">#FF354054</Color>
    <Color x:Key="Color.TextPrimary">#FFEDF1F7</Color>
    <Color x:Key="Color.TextSecondary">#FF9BA6B7</Color>
    <Color x:Key="Color.TextDisabled">#FF606B7D</Color>
    <Color x:Key="Color.Accent">#FF4F8CFF</Color>
    <Color x:Key="Color.AccentHover">#FF6A9DFF</Color>
    <Color x:Key="Color.AccentPressed">#FF3C78E8</Color>
    <Color x:Key="Color.AccentText">#FFFFFFFF</Color>
    <Color x:Key="Color.Danger">#FFFF5C5C</Color>
    <Color x:Key="Color.Warning">#FFF0B23B</Color>
    <Color x:Key="Color.Success">#FF3CCB7F</Color>
    <Color x:Key="Color.Selection">#FF1E2634</Color>
    <Color x:Key="Color.Overlay">#99000000</Color>

    <SolidColorBrush x:Key="Brush.Window" Color="{StaticResource Color.Window}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="{StaticResource Color.SurfaceAlt}" />
    <SolidColorBrush x:Key="Brush.SurfaceHover" Color="{StaticResource Color.SurfaceHover}" />
    <SolidColorBrush x:Key="Brush.SurfacePressed" Color="{StaticResource Color.SurfacePressed}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="{StaticResource Color.BorderStrong}" />
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="{StaticResource Color.TextPrimary}" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}" />
    <SolidColorBrush x:Key="Brush.TextDisabled" Color="{StaticResource Color.TextDisabled}" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="{StaticResource Color.AccentHover}" />
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="{StaticResource Color.AccentPressed}" />
    <SolidColorBrush x:Key="Brush.AccentText" Color="{StaticResource Color.AccentText}" />
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" />
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" />
    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />
    <SolidColorBrush x:Key="Brush.Selection" Color="{StaticResource Color.Selection}" />
    <SolidColorBrush x:Key="Brush.Overlay" Color="{StaticResource Color.Overlay}" />

    <sys:Double x:Key="Size.Radius">8</sys:Double>
    <sys:Double x:Key="Size.Radius.Small">5</sys:Double>
    <FontFamily x:Key="Font.Ui">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Icon">Segoe MDL2 Assets</FontFamily>

</ResourceDictionary>
