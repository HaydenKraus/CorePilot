<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Keyed value used by ThemeService to locate and swap this dictionary. -->
    <sys:String x:Key="Theme.Name">Light</sys:String>

    <Color x:Key="Color.Window">#FFF3F5F9</Color>
    <Color x:Key="Color.Surface">#FFFFFFFF</Color>
    <Color x:Key="Color.SurfaceAlt">#FFF7F8FB</Color>
    <Color x:Key="Color.SurfaceHover">#FFEDF0F6</Color>
    <Color x:Key="Color.SurfacePressed">#FFE2E7F0</Color>
    <Color x:Key="Color.Border">#FFE1E5EE</Color>
    <Color x:Key="Color.BorderStrong">#FFCBD2E0</Color>
    <Color x:Key="Color.TextPrimary">#FF121620</Color>
    <Color x:Key="Color.TextSecondary">#FF5A6476</Color>
    <Color x:Key="Color.TextDisabled">#FF9AA3B2</Color>
    <Color x:Key="Color.Accent">#FF3B7CFF</Color>
    <Color x:Key="Color.AccentHover">#FF2E6BEA</Color>
    <Color x:Key="Color.AccentPressed">#FF245AD0</Color>
    <Color x:Key="Color.AccentText">#FFFFFFFF</Color>
    <Color x:Key="Color.Danger">#FFE23D3D</Color>
    <Color x:Key="Color.Warning">#FFE39B1B</Color>
    <Color x:Key="Color.Success">#FF2FA86A</Color>
    <Color x:Key="Color.Selection">#FFE6EDF9</Color>
    <Color x:Key="Color.Overlay">#66000000</Color>

    <SolidColorBrush x:Key="Brush.Window" Color="{StaticResource Color.Window}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="{StaticResource Color.SurfaceAlt}" />
    <SolidColorBrush x:Key="Brush.SurfaceHover" Color="{StaticResource Color.SurfaceHover}" />
    <SolidColorBrush x:Key="Brush.SurfacePressed" Color="{StaticResource Color.SurfacePressed}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="{StaticResource Color.BorderStrong}" />
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="{StaticResource Color.TextPrimary}" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}" />
    <SolidColorBrush x:Key="Brush.TextDisabled" Color="{StaticResource Color.TextDisabled}" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="{StaticResource Color.AccentHover}" />
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="{StaticResource Color.AccentPressed}" />
    <SolidColorBrush x:Key="Brush.AccentText" Color="{StaticResource Color.AccentText}" />
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" />
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" />
    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />
    <SolidColorBrush x:Key="Brush.Selection" Color="{StaticResource Color.Selection}" />
    <SolidColorBrush x:Key="Brush.Overlay" Color="{StaticResource Color.Overlay}" />

    <sys:Double x:Key="Size.Radius">8</sys:Double>
    <sys:Double x:Key="Size.Radius.Small">5</sys:Double>
    <FontFamily x:Key="Font.Ui">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Icon">Segoe MDL2 Assets</FontFamily>

</ResourceDictionary>
