<UserControl x:Class="CorePilot.App.Controls.SearchBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:CorePilot.App.Localization"
             x:Name="Root">
    <Border Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="1"
            CornerRadius="8"
            Height="34">
        <Grid Margin="10,0,4,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="&#xE721;"
                       FontFamily="{DynamicResource Font.Icon}"
                       FontSize="13"
                       Foreground="{DynamicResource Brush.TextSecondary}"
                       VerticalAlignment="Center" />

            <Grid Grid.Column="1" Margin="8,0">
                <TextBox x:Name="Input"
                         Text="{Binding Text, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0"
                         FontSize="13"
                         VerticalContentAlignment="Center"
                         FocusVisualStyle="{x:Null}" />
                <TextBlock x:Name="PlaceholderText"
                           Text="{Binding Placeholder, ElementName=Root}"
                           Foreground="{DynamicResource Brush.TextDisabled}"
                           FontSize="13"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           TextTrimming="CharacterEllipsis" />
            </Grid>

            <Button x:Name="ClearButton"
                    Grid.Column="2"
                    Style="{StaticResource Button.Icon}"
                    Width="22"
                    Height="22"
                    Padding="0"
                    Visibility="Collapsed"
                    ToolTip="{Binding [common.clear], Source={x:Static loc:LocalizationService.Instance}}"
                    Click="Clear_Click">
                <TextBlock Text="&#xE711;"
                           FontFamily="{DynamicResource Font.Icon}"
                           FontSize="9"
                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            </Button>
        </Grid>
    </Border>
</UserControl>
