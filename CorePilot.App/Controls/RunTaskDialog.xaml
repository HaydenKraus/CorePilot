<Window x:Class="CorePilot.App.Controls.RunTaskDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:CorePilot.App.Localization"
        Title="{Binding [runTask.title], Source={x:Static loc:LocalizationService.Instance}}"
        Width="560"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Border Margin="18"
            Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="1"
            CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.28" Color="Black" />
        </Border.Effect>

        <Grid Margin="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource Brush.Accent}">
                        <TextBlock Text="&#xE768;"
                                   FontFamily="{DynamicResource Font.Icon}"
                                   FontSize="15"
                                   Foreground="{DynamicResource Brush.AccentText}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{Binding [runTask.title], Source={x:Static loc:LocalizationService.Instance}}"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>

                <Button Grid.Column="1"
                        Style="{StaticResource Button.Icon}"
                        Width="30"
                        Height="30"
                        Click="Cancel_Click">
                    <TextBlock Text="&#xE8BB;"
                               FontFamily="{DynamicResource Font.Icon}"
                               FontSize="10"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
            </Grid>

            <StackPanel Grid.Row="1" Margin="0,0,0,14">
                <TextBlock Text="{Binding [runTask.path], Source={x:Static loc:LocalizationService.Instance}}"
                           Style="{StaticResource Text.Caption}"
                           Margin="0,0,0,6" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="PathBox" Height="34" VerticalContentAlignment="Center" />
                    <Button Grid.Column="1"
                            Content="{Binding [runTask.browse], Source={x:Static loc:LocalizationService.Instance}}"
                            Style="{StaticResource Button.Base}"
                            Margin="8,0,0,0"
                            Padding="12,6"
                            Click="Browse_Click" />
                </Grid>
            </StackPanel>

            <StackPanel Grid.Row="2" Margin="0,0,0,14">
                <TextBlock Text="{Binding [runTask.arguments], Source={x:Static loc:LocalizationService.Instance}}"
                           Style="{StaticResource Text.Caption}"
                           Margin="0,0,0,6" />
                <TextBox x:Name="ArgumentsBox" Height="34" VerticalContentAlignment="Center" />
            </StackPanel>

            <StackPanel Grid.Row="3" Margin="0,0,0,14">
                <TextBlock Text="{Binding [runTask.workingDirectory], Source={x:Static loc:LocalizationService.Instance}}"
                           Style="{StaticResource Text.Caption}"
                           Margin="0,0,0,6" />
                <TextBox x:Name="WorkingDirectoryBox" Height="34" VerticalContentAlignment="Center" />
            </StackPanel>

            <Grid Grid.Row="4" Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="ErrorText"
                           Foreground="{DynamicResource Brush.Danger}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Visibility="Collapsed" />

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="{Binding [common.cancel], Source={x:Static loc:LocalizationService.Instance}}"
                            Style="{StaticResource Button.Base}"
                            Padding="16,7"
                            Click="Cancel_Click" />
                    <Button Style="{StaticResource Button.Accent}"
                            Margin="8,0,0,0"
                            Padding="16,7"
                            Click="Start_Click">
                        <TextBlock Text="{Binding [runTask.start], Source={x:Static loc:LocalizationService.Instance}}"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
