<UserControl x:Class="CorePilot.App.Controls.CoreAffinityGrid"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:CorePilot.App.Localization">
    <Grid>
        <ScrollViewer MaxHeight="216"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding HasCoreGroups, Converter={StaticResource BoolToVisibility}}">
            <ItemsControl ItemsSource="{Binding CoreGroups}"
                          ItemTemplate="{StaticResource CoreGroupTemplate}" />
        </ScrollViewer>

        <TextBlock Text="{Binding [error.topologyUnavailable], Source={x:Static loc:LocalizationService.Instance}}"
                   Style="{StaticResource Text.Caption}"
                   Visibility="{Binding HasCoreGroups, Converter={StaticResource InverseBoolToVisibility}}" />
    </Grid>
</UserControl>
