<UserControl x:Class="CorePilot.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:CorePilot.App.Localization"
             FontFamily="{DynamicResource Font.Ui}"
             Background="Transparent">

    <UserControl.Resources>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        </Style>

        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        </Style>

        <Style x:Key="RowHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>

        <Style x:Key="ToggleSwitch" TargetType="ToggleButton">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="23" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Track"
                                CornerRadius="12"
                                Background="{DynamicResource Brush.BorderStrong}">
                            <Grid>
                                <Ellipse x:Name="Thumb"
                                         Width="17" Height="17"
                                         Fill="White"
                                         HorizontalAlignment="Left"
                                         VerticalAlignment="Center"
                                         Margin="3,0,0,0" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource Brush.Accent}" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WideCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Width" Value="220" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>

        <Style x:Key="OptionRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,14,0,0" />
        </Style>

    </UserControl.Resources>

    <Grid Margin="24,20,24,20">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="880" HorizontalAlignment="Left">

                <TextBlock Text="{Binding [settings.title], Source={x:Static loc:LocalizationService.Instance}}"
                           Style="{StaticResource Text.Title}" />
                <TextBlock Text="{Binding [settings.subtitle], Source={x:Static loc:LocalizationService.Instance}}"
                           Style="{StaticResource Text.Caption}"
                           TextWrapping="Wrap"
                           Margin="0,4,0,18" />

                <!-- Appearance -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}"
                                   Text="{Binding [settings.section.appearance], Source={x:Static loc:LocalizationService.Instance}}" />

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Style="{StaticResource FieldLabel}"
                                           Text="{Binding [settings.theme.label], Source={x:Static loc:LocalizationService.Instance}}" />
                                <ComboBox Style="{StaticResource WideCombo}"
                                          ItemsSource="{Binding Themes}"
                                          SelectedItem="{Binding SelectedTheme, Mode=TwoWay}"
                                          ItemTemplate="{StaticResource LocalizedOptionTemplate}" />
                                <TextBlock Style="{StaticResource RowHint}"
                                           Text="{Binding [settings.theme.hint], Source={x:Static loc:LocalizationService.Instance}}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource FieldLabel}"
                                           Text="{Binding [settings.language.label], Source={x:Static loc:LocalizationService.Instance}}" />
                                <ComboBox Style="{StaticResource WideCombo}"
                                          ItemsSource="{Binding Languages}"
                                          SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                                          ItemTemplate="{StaticResource LocalizedOptionTemplate}" />
                                <TextBlock Style="{StaticResource RowHint}"
                                           Text="{Binding [settings.language.hint], Source={x:Static loc:LocalizationService.Instance}}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Behavior -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}"
                                   Text="{Binding [settings.section.behavior], Source={x:Static loc:LocalizationService.Instance}}" />

                        <Grid Style="{StaticResource OptionRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource RowTitle}"
                                           Text="{Binding [settings.refresh.label], Source={x:Static loc:LocalizationService.Instance}}" />
                                <TextBlock Style="{StaticResource RowHint}"
                                           Text="{Binding [settings.refresh.hint], Source={x:Static loc:LocalizationService.Instance}}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding RefreshText}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Margin="12,0,0,0" />
                        </Grid>

                        <Slider Minimum="0.5"
                                Maximum="5"
                                SmallChange="0.1"
                                LargeChange="0.5"
                                Margin="0,4,0,2"
                                IsMoveToPointEnabled="True"
                                Value="{Binding RefreshSeconds, Mode=TwoWay, Delay=250}" />

                        <Grid Style="{StaticResource OptionRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource RowTitle}"
                                           Text="{Binding [settings.option.startWithWindows], Source={x:Static loc:LocalizationService.Instance}}" />
                                <TextBlock Style="{StaticResource RowHint}"
                                           Text="{Binding [settings.option.startWithWindows.hint], Source={x:Static loc:LocalizationService.Instance}}" />
                                <TextBlock Text="{Binding AutostartError}"
                                           Foreground="{DynamicResource Brush.Warning}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasAutostartError}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <ToggleButton Grid.Column="1"
                                          Style="{StaticResource ToggleSwitch}"
                                          IsChecked="{Binding StartWithWindows, Mode=TwoWay}" />
                        </Grid>

                        <Grid Style="{StaticResource OptionRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource RowTitle}"
                                           Text="{Binding [settings.option.startMinimized], Source={x:Static loc:LocalizationService.Instance}}" />
                                <TextBlock Style="{StaticResource RowHint}"
                                           Text="{Binding [settings.option.startMinimized.hint], Source={x:Static loc:LocalizationService.Instance}}" />
                            </StackPanel>
                            <ToggleButton Grid.Column="1"
                                          Style="{StaticResource ToggleSwitch}"
                                          IsChecked="{Binding StartMinimized, Mode=TwoWay}" />
                        </Grid>

                        <Grid Style="{StaticResource OptionRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource RowTitle}"
                                           Text="{Binding [settings.option.minimizeToTray], Source={x:Static loc:LocalizationService.Instance}}" />
                                <TextBlock Style="{StaticResource RowHint}"
                                           Text="{Binding [settings.option.minimizeToTray.hint], Source={x:Static loc:LocalizationService.Instance}}" />
                            </StackPanel>
                            <ToggleButton Grid.Column="1"
                                          Style="{StaticResource ToggleSwitch}"
                                          IsChecked="{Binding MinimizeToTray, Mode=TwoWay}" />
                        </Grid>

                        <Grid Style="{StaticResource OptionRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource RowTitle}"
                                           Text="{Binding [settings.option.closeToTray], Source={x:Static loc:LocalizationService.Instance}}" />
                                <TextBlock Style="{StaticResource RowHint}"
                                           Text="{Binding [settings.option.closeToTray.hint], Source={x:Static loc:LocalizationService.Instance}}" />
                            </StackPanel>
                            <ToggleButton Grid.Column="1"
                                          Style="{StaticResource ToggleSwitch}"
                                          IsChecked="{Binding CloseToTray, Mode=TwoWay}" />
                        </Grid>

                        <Grid Style="{StaticResource OptionRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource RowTitle}"
                                           Text="{Binding [settings.option.applyOnStartup], Source={x:Static loc:LocalizationService.Instance}}" />
                                <TextBlock Style="{StaticResource RowHint}"
                                           Text="{Binding [settings.option.applyOnStartup.hint], Source={x:Static loc:LocalizationService.Instance}}" />
                            </StackPanel>
                            <ToggleButton Grid.Column="1"
                                          Style="{StaticResource ToggleSwitch}"
                                          IsChecked="{Binding ApplyRulesOnStartup, Mode=TwoWay}" />
                        </Grid>

                        <Grid Style="{StaticResource OptionRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource RowTitle}"
                                           Text="{Binding [settings.option.keepEnforced], Source={x:Static loc:LocalizationService.Instance}}" />
                                <TextBlock Style="{StaticResource RowHint}"
                                           Text="{Binding [settings.option.keepEnforced.hint], Source={x:Static loc:LocalizationService.Instance}}" />
                            </StackPanel>
                            <ToggleButton Grid.Column="1"
                                          Style="{StaticResource ToggleSwitch}"
                                          IsChecked="{Binding KeepRulesEnforced, Mode=TwoWay}" />
                        </Grid>

                        <Grid Style="{StaticResource OptionRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource RowTitle}"
                                           Text="{Binding [settings.option.showSuspended], Source={x:Static loc:LocalizationService.Instance}}" />
                                <TextBlock Style="{StaticResource RowHint}"
                                           Text="{Binding [settings.option.showSuspended.hint], Source={x:Static loc:LocalizationService.Instance}}" />
                            </StackPanel>
                            <ToggleButton Grid.Column="1"
                                          Style="{StaticResource ToggleSwitch}"
                                          IsChecked="{Binding ShowSuspendedProcesses, Mode=TwoWay}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Status -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}"
                                   Text="{Binding [settings.section.status], Source={x:Static loc:LocalizationService.Instance}}" />

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <TextBlock Text="&#xE72E;"
                                       FontFamily="{DynamicResource Font.Icon}"
                                       FontSize="18"
                                       Margin="0,0,10,0"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsElevated}" Value="False">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding ElevationText}"
                                       TextWrapping="Wrap"
                                       MaxWidth="720"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsElevated}" Value="False">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <TextBlock Text="{Binding [settings.status.file], Source={x:Static loc:LocalizationService.Instance}}"
                                   Style="{StaticResource RowHint}"
                                   Margin="0,14,0,3" />
                        <TextBlock Text="{Binding SettingsPath}"
                                   FontSize="12"
                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding SettingsPath}" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
