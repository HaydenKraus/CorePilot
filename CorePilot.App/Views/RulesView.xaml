<UserControl x:Class="CorePilot.App.Views.RulesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:CorePilot.App.Localization"
             xmlns:vm="clr-namespace:CorePilot.App.ViewModels"
             FontFamily="{DynamicResource Font.Ui}"
             Background="Transparent">

    <UserControl.Resources>

        <Style x:Key="Card.Border" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="12,10" />
        </Style>

        <Style x:Key="RuleItemContainer" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter HorizontalAlignment="Stretch" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToggleSwitch" TargetType="ToggleButton">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Track"
                                CornerRadius="11"
                                Background="{DynamicResource Brush.BorderStrong}">
                            <Grid>
                                <Ellipse x:Name="Thumb"
                                         Width="16" Height="16"
                                         Fill="White"
                                         HorizontalAlignment="Left"
                                         VerticalAlignment="Center"
                                         Margin="3,0,0,0" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource Brush.Accent}" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SwitchLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="Margin" Value="7,0,0,0" />
        </Style>

        <Style x:Key="SwitchLabel.Strong" TargetType="TextBlock" BasedOn="{StaticResource SwitchLabel}">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        </Style>

        <Style x:Key="CardButton" TargetType="Button" BasedOn="{StaticResource Button.Base}">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>

        <Style x:Key="CoreToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Root"
                                Background="{DynamicResource Brush.SurfaceAlt}"
                                BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource Size.Radius.Small}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Accent}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CoreNumber" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.AccentText}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CoreKind" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="Opacity" Value="0.65" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.AccentText}" />
                    <Setter Property="Opacity" Value="0.9" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="Margin" Value="0,12,0,5" />
        </Style>

        <Style x:Key="EditorTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <DataTemplate DataType="{x:Type vm:RuleItemViewModel}">
            <Border>
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Card.Border}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Brush.SurfaceAlt}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <StackPanel>
                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" Margin="12,0,0,0">
                            <ToggleButton Style="{StaticResource ToggleSwitch}"
                                          IsChecked="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          ToolTip="{Binding [rules.card.enabled], Source={x:Static loc:LocalizationService.Instance}}" />
                            <TextBlock Style="{StaticResource SwitchLabel.Strong}"
                                       Text="{Binding [rules.card.enabled], Source={x:Static loc:LocalizationService.Instance}}" />
                        </StackPanel>
                        <TextBlock Text="{Binding Name}"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                    </DockPanel>

                    <TextBlock Text="{Binding Path}"
                               Style="{StaticResource Text.Caption}"
                               Margin="0,3,0,0"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Path}" />

                    <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                        <TextBlock Text="{Binding [rules.card.cores], Source={x:Static loc:LocalizationService.Instance}}"
                                   Style="{StaticResource Text.Caption}" />
                        <TextBlock Text=" · " Style="{StaticResource Text.Caption}" />
                        <TextBlock Text="{Binding MaskText}"
                                   FontSize="12"
                                   FontWeight="SemiBold" />
                    </StackPanel>

                    <TextBlock Text="{Binding PriorityText}"
                               Style="{StaticResource Text.Caption}"
                               Margin="0,3,0,0"
                               TextTrimming="CharacterEllipsis" />

                    <DockPanel LastChildFill="True" Margin="0,12,0,0">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource CardButton}"
                                    Content="{Binding [rules.card.applyNow], Source={x:Static loc:LocalizationService.Instance}}"
                                    Command="{Binding DataContext.ApplyRuleCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    CommandParameter="{Binding}" />
                            <Button Style="{StaticResource CardButton}"
                                    Command="{Binding DataContext.DeleteRuleCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    CommandParameter="{Binding}">
                                <TextBlock Text="{Binding [rules.card.delete], Source={x:Static loc:LocalizationService.Instance}}"
                                           Foreground="{DynamicResource Brush.Danger}" />
                            </Button>
                        </StackPanel>

                        <WrapPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                                <ToggleButton Style="{StaticResource ToggleSwitch}"
                                              Width="34" Height="19"
                                              IsChecked="{Binding ApplyOnStart, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Style="{StaticResource SwitchLabel}"
                                           Text="{Binding [rules.card.applyOnStart], Source={x:Static loc:LocalizationService.Instance}}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <ToggleButton Style="{StaticResource ToggleSwitch}"
                                              Width="34" Height="19"
                                              IsChecked="{Binding KeepEnforced, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Style="{StaticResource SwitchLabel}"
                                           Text="{Binding [rules.card.keepEnforced], Source={x:Static loc:LocalizationService.Instance}}" />
                            </StackPanel>
                        </WrapPanel>
                    </DockPanel>

                    <TextBlock Text="{Binding StatusText}"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusText}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </DataTemplate>

    </UserControl.Resources>

    <Grid Margin="24,20,24,20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="430" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,0,20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,16" LastChildFill="True">
                <Button DockPanel.Dock="Right"
                        Style="{StaticResource Button.Accent}"
                        Padding="14,8"
                        VerticalAlignment="Top"
                        Command="{Binding NewRuleCommand}">
                    <TextBlock Text="{Binding [rules.add], Source={x:Static loc:LocalizationService.Instance}}"
                               Foreground="{DynamicResource Brush.AccentText}" />
                </Button>
                <StackPanel>
                    <TextBlock Text="{Binding [rules.title], Source={x:Static loc:LocalizationService.Instance}}"
                               Style="{StaticResource Text.Title}" />
                    <TextBlock Text="{Binding [rules.subtitle], Source={x:Static loc:LocalizationService.Instance}}"
                               Style="{StaticResource Text.Caption}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0" />
                </StackPanel>
            </DockPanel>

            <Grid Grid.Row="1">
                <ListBox ItemsSource="{Binding Rules}"
                         SelectedItem="{Binding SelectedRule, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource RuleItemContainer}"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" />

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="340">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasRules}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="&#xE8FD;"
                               FontFamily="{DynamicResource Font.Icon}"
                               FontSize="30"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource Brush.TextDisabled}" />
                    <TextBlock Text="{Binding [rules.empty.title], Source={x:Static loc:LocalizationService.Instance}}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Margin="0,12,0,0" />
                    <TextBlock Text="{Binding [rules.empty.hint], Source={x:Static loc:LocalizationService.Instance}}"
                               Style="{StaticResource Text.Caption}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="0,6,0,0" />
                </StackPanel>
            </Grid>
        </Grid>

        <Border Grid.Column="1"
                Background="Transparent"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="1,0,0,0"
                Padding="20,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="{Binding Editor.HeaderText}" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding [rules.editor.hint], Source={x:Static loc:LocalizationService.Instance}}"
                               Style="{StaticResource Text.Caption}"
                               TextWrapping="Wrap"
                               Margin="0,5,0,4" />

                    <TextBlock Style="{StaticResource FieldLabel}"
                               Text="{Binding [rules.editor.name], Source={x:Static loc:LocalizationService.Instance}}" />
                    <TextBox Style="{StaticResource EditorTextBox}"
                             Text="{Binding Editor.DisplayName, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Style="{StaticResource FieldLabel}"
                               Text="{Binding [rules.editor.path], Source={x:Static loc:LocalizationService.Instance}}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Style="{StaticResource EditorTextBox}"
                                 Text="{Binding Editor.ExecutablePath, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1"
                                Style="{StaticResource CardButton}"
                                Margin="8,0,0,0"
                                Padding="12,7"
                                Content="{Binding [rules.editor.browse], Source={x:Static loc:LocalizationService.Instance}}"
                                Command="{Binding BrowseCommand}" />
                    </Grid>

                    <DockPanel Margin="0,16,0,6" LastChildFill="True">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource CardButton}"
                                    Padding="9,4"
                                    Content="{Binding [rules.editor.all], Source={x:Static loc:LocalizationService.Instance}}"
                                    Command="{Binding Editor.SelectAllCoresCommand}" />
                            <Button Style="{StaticResource CardButton}"
                                    Padding="9,4"
                                    Content="{Binding [rules.editor.none], Source={x:Static loc:LocalizationService.Instance}}"
                                    Command="{Binding Editor.SelectNoCoresCommand}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock FontSize="13" FontWeight="SemiBold"
                                       Text="{Binding [rules.editor.cores], Source={x:Static loc:LocalizationService.Instance}}" />
                            <TextBlock Text="{Binding Editor.SummaryText}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                    </DockPanel>

                    <ItemsControl ItemsSource="{Binding Editor.Groups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="0,0,0,4"
                                        Margin="0,0,0,4">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Label}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                                   Margin="0,0,0,6" />
                                        <ItemsControl ItemsSource="{Binding Cores}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <ToggleButton Style="{StaticResource CoreToggle}"
                                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                  ToolTip="{Binding Tooltip}">
                                                        <StackPanel>
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                                <TextBlock Style="{StaticResource CoreNumber}" Text="{Binding Index}" />
                                                                <TextBlock Text="v"
                                                                           FontSize="7"
                                                                           FontWeight="SemiBold"
                                                                           Margin="1,0,0,0"
                                                                           VerticalAlignment="Top"
                                                                           Opacity="0.8"
                                                                           Visibility="{Binding IsVirtual, Converter={StaticResource BoolToVisibility}}" />
                                                            </StackPanel>
                                                            <TextBlock Style="{StaticResource CoreKind}" Text="{Binding Kind}" />
                                                        </StackPanel>
                                                    </ToggleButton>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{Binding [rules.editor.cpu], Source={x:Static loc:LocalizationService.Instance}}"
                               Style="{StaticResource FieldLabel}" Margin="0,6,0,5" />
                    <ComboBox ItemsSource="{Binding Editor.CpuPriorities}"
                              SelectedItem="{Binding Editor.CpuPriority, Mode=TwoWay}"
                              ItemTemplate="{StaticResource LocalizedOptionTemplate}" />

                    <TextBlock Text="{Binding [rules.editor.io], Source={x:Static loc:LocalizationService.Instance}}"
                               Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding Editor.IoPriorities}"
                              SelectedItem="{Binding Editor.IoPriority, Mode=TwoWay}"
                              ItemTemplate="{StaticResource LocalizedOptionTemplate}" />

                    <TextBlock Text="{Binding [rules.editor.memory], Source={x:Static loc:LocalizationService.Instance}}"
                               Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding Editor.MemoryPriorities}"
                              SelectedItem="{Binding Editor.MemoryPriority, Mode=TwoWay}"
                              ItemTemplate="{StaticResource LocalizedOptionTemplate}" />

                    <TextBlock Text="{Binding [rules.editor.behavior], Source={x:Static loc:LocalizationService.Instance}}"
                               FontSize="13" FontWeight="SemiBold" Margin="0,18,0,6" />

                    <CheckBox IsChecked="{Binding Editor.Enabled, Mode=TwoWay}"
                              Content="{Binding [rules.editor.enabled], Source={x:Static loc:LocalizationService.Instance}}"
                              Margin="0,4" />
                    <CheckBox IsChecked="{Binding Editor.ApplyOnStart, Mode=TwoWay}"
                              Content="{Binding [rules.editor.applyOnStart], Source={x:Static loc:LocalizationService.Instance}}"
                              Margin="0,4" />
                    <CheckBox IsChecked="{Binding Editor.KeepEnforced, Mode=TwoWay}"
                              Content="{Binding [rules.editor.keepEnforced], Source={x:Static loc:LocalizationService.Instance}}"
                              Margin="0,4" />

                    <Button Style="{StaticResource Button.Accent}"
                            Height="36"
                            Margin="0,18,0,0"
                            IsEnabled="{Binding Editor.CanSave}"
                            Command="{Binding SaveRuleCommand}">
                        <TextBlock Text="{Binding [rules.editor.save], Source={x:Static loc:LocalizationService.Instance}}"
                                   Foreground="{DynamicResource Brush.AccentText}" />
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
